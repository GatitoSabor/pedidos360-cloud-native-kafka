# URL pública del API Gateway o del backend local.
VITE_API_URL=http://localhost:8080

# Datos de la aplicación web registrada en Amazon Cognito.
# No subir secretos: el client ID de una SPA es público, pero las credenciales no.
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=example-client-id
